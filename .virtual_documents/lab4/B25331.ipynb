def rmse(y_true, y_pred):
    n = len(y_true)
    return np.sqrt((1/n) * np.sum((y_true - y_pred)**2))

def r2_score_scratch(y_true, y_pred):
    y_mean = np.mean(y_true)
    ss_res = np.sum((y_true - y_pred)**2)
    ss_tot = np.sum((y_true - y_mean)**2)
    return 1 - (ss_res / ss_tot)
